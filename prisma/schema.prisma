datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Document {
  id            String             @id @default(uuid())
  sku           String
  title         String
  category      String             // "Konformitätserklärung", "Anleitung", "Datenblatt", etc.
  language      String             @default("DE") // "DE", "EN", "FR", "IT", "ES", "MULTI"
  publicToken   String             @unique @default(uuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  revisions     DocumentRevision[]
  auditLogs     AuditLog[]
}

model DocumentRevision {
  id             String   @id @default(uuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionNumber Int
  fileName       String
  filePath       String
  fileSize       Int
  mimeType       String   @default("application/pdf")
  sha256Hash     String
  comment        String?
  uploadedBy     String   @default("Admin")
  createdAt      DateTime @default(now())

  @@unique([documentId, revisionNumber])
}

model AuditLog {
  id         String    @id @default(uuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  action     String
  details    String
  user       String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
